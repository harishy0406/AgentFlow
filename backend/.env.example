# ==============================================================================
# AgentFlow Multi-Provider Environment Configuration
# ==============================================================================
# Copy this file to .env in the backend directory:
#   cp backend/.env.example backend/.env
#
# You DO NOT need to fill all keys! Add whatever free keys you have.
# The Quality Router will automatically prioritize free models first ($0.00 cost)
# so your API quota and limits will not be hit!
# ==============================================================================


# ==============================================================================
# 1. 100% FREE & ULTRA-FAST PROVIDERS (RECOMMENDED)
# ==============================================================================

# GROQ (100% Free Developer Tier, 500+ tok/sec)
# Get free key: https://console.groq.com/keys
# Free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it, deepseek-r1-distill-llama-70b
GROQ_API_KEY=

# GOOGLE GEMINI (Free Tier via Google AI Studio — 15 RPM / 1M TPM free)
# Get free key: https://aistudio.google.com/app/apikey
# Free models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# OPENROUTER (Free Community Models with :free tag)
# Get free key: https://openrouter.ai/keys
# Free models: meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free, deepseek/deepseek-r1:free, qwen/qwen-2.5-coder-32b-instruct:free, mistralai/mistral-7b-instruct:free
OPENROUTER_API_KEY=

# CEREBRAS (Ultra-Fast Wafer Engine, Free Tier)
# Get free key: https://cloud.cerebras.ai/
# Free models: llama3.1-70b, llama3.1-8b
CEREBRAS_API_KEY=

# MISTRAL AI (Free Developer Experimenter Tier on La Plateforme)
# Get free key: https://console.mistral.ai/api-keys/
# Free models: mistral-small-latest, codestral-latest (code specialist), open-mistral-nemo
MISTRAL_API_KEY=


# ==============================================================================
# 2. LOCAL OFFLINE LLMs (UNLIMITED & 100% FREE, NO KEY NEEDED)
# ==============================================================================

# OLLAMA (Run local models on your PC with zero API limits)
# Download: https://ollama.ai/ (e.g. `ollama run llama3.2` or `ollama run deepseek-coder`)
# Set to true when you want Ollama enabled
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1


# ==============================================================================
# 3. LOW-COST & STARTUP CREDIT PROVIDERS
# ==============================================================================

# DEEPSEEK (V3 and R1 Reasoning Models, ultra low cost with free initial credits)
# Get key: https://platform.deepseek.com/api_keys
# Models: deepseek-chat (V3), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=

# TOGETHER AI (Free trial credits & open models)
# Get key: https://api.together.ai/
# Models: meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo, meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
TOGETHER_API_KEY=


# ==============================================================================
# 4. STANDARD COMMERCIAL PROVIDERS (PAID / TIERED)
# ==============================================================================

# OpenAI API Key (starts with sk-...)
# Get key: https://platform.openai.com/api-keys
# Models: gpt-4o-mini, gpt-4o
OPENAI_API_KEY=

# Anthropic API Key (starts with sk-ant-...)
# Get key: https://console.anthropic.com/
# Models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-haiku-20240307
ANTHROPIC_API_KEY=


# ==============================================================================
# 5. DATABASE & INFRASTRUCTURE CONFIGURATION (OPTIONAL)
# ==============================================================================

# Database URL: defaults to local SQLite agentflow.db if PostgreSQL is not running
DATABASE_URL=sqlite:///./agentflow.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentflow

# Redis URL: used for caching & event stream (optional)
REDIS_URL=redis://localhost:6379/0
